{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "ip-local",
          "type": "qml"
        },
        {
          "id": "ip-public",
          "type": "qml"
        },
        {
          "id": "ghostty",
          "type": "command",
          "fontSize": 16,
          "exec": "echo '{\"text\":\"󰆍\"}'",
          "tooltip": "Terminal general (Ghostty)",
          "onClick": "ghostty"
        },
        {
          "id": "alacritty-ssh",
          "type": "command",
          "fontSize": 16,
          "exec": "echo '{\"text\":\"󰣀\"}'",
          "tooltip": "Terminal SSH (Alacritty)",
          "onClick": "alacritty --working-directory ~/.ssh"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
